<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:background="@drawable/bg_message_received">

    <!-- Three dots (animated in Java) -->
    <View android:id="@+id/dot1" android:layout_width="6dp" android:layout_height="6dp"
        android:background="@drawable/shape_circle" android:layout_marginEnd="4dp"/>
    <View android:id="@+id/dot2" android:layout_width="6dp" android:layout_height="6dp"
        android:background="@drawable/shape_circle" android:layout_marginEnd="4dp"/>
    <View android:id="@+id/dot3" android:layout_width="6dp" android:layout_height="6dp"
        android:background="@drawable/shape_circle"/>

    <TextView
        android:id="@+id/tvTypingText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/text_muted"
        android:layout_marginStart="10dp" />
</LinearLayout>